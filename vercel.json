{
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "api/index.py"
    }
  ],
  "headers": [
    {
      "source": "/static/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/static/(.*)\\.(css|js|ico|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
