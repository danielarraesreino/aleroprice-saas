{
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "aleroprice-bardavila"
      }
    }
  ],
  "services": {
    "aleroprice-bardavila": {
      "root": "."
    }
  }
}
