# =============================================================================
# AleroPrice / Feira de Barão — variáveis de ambiente
# =============================================================================
# Copie para `.env` e preencha. A lista abaixo é o inventário completo do que o
# código lê (`os.environ.get` em app/, run.py e api/) — se uma variável não está
# aqui, não é usada.
#
# Legenda:
#   [OBRIGATÓRIA]  produção não sobe (ou sobe quebrada) sem isso
#   [RECOMENDADA]  funciona sem, mas com comportamento pior
#   [OPCIONAL]     recurso extra, inerte quando ausente
# =============================================================================


# -----------------------------------------------------------------------------
# Núcleo
# -----------------------------------------------------------------------------

# [OBRIGATÓRIA em produção] Qual config carregar: development | testing | production.
# Sem esta variável, `run.py` só assume produção se detectar VERCEL ou
# RAILWAY_ENVIRONMENT. Em qualquer outro host, cai em development —
# com DEBUG ligado e o billing em modo simulado. Sempre defina explicitamente.
APP_ENV=development

# [OBRIGATÓRIA em produção] Assina a sessão e os cookies de login.
# Em development há um fallback embutido; ProductionConfig exige esta variável.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# [OPCIONAL] Chave separada para JWT. Ausente, reaproveita SECRET_KEY.
JWT_SECRET_KEY=

# [OBRIGATÓRIA em produção] Postgres. Sem ela, ProductionConfig cai em SQLite
# in-memory: o app sobe, e todo dado desaparece no próximo cold start.
# Formatos aceitos: postgres:// e postgresql:// (o primeiro é convertido).
# Em desenvolvimento, ausente = SQLite em instance/alerodb.sqlite.
DATABASE_URL=postgresql://usuario:senha@host:5432/banco


# -----------------------------------------------------------------------------
# Site multi-tenant (Feira de Barão)
# -----------------------------------------------------------------------------

# [RECOMENDADA] Domínio do produto. Um Host diferente deste é tratado como
# domínio de cliente e serve o site daquele bar (app/utils/site_router.py).
# Ausente, assume feiradebarao.com.br.
DOMINIO_PRODUTO=feiradebarao.com.br

# [RECOMENDADA] Contato comercial. Aparece na landing de venda, no botão dos
# planos (a venda é por telefone) e no rodapé das prévias de prospecção.
# Só dígitos, com DDI e DDD.
FEIRA_WHATSAPP=5519999999999
FEIRA_EMAIL=contato@feiradebarao.com.br

# [OPCIONAL] Texto da landing de venda.
FEIRA_PRECO=R$ 129
FEIRA_PRECO_PERIODO=por mês
FEIRA_PRECO_DETALHE=

# [RECOMENDADA] Preço de cada plano. Fonte única: a tela de planos e a landing
# leem daqui. Antes divergiam sozinhas (R$ 97 numa, R$ 197 na outra).
FEIRA_PRECO_SITE=R$ 129
FEIRA_PRECO_PRO=R$ 249


# -----------------------------------------------------------------------------
# Stripe — assinatura dos lojistas
# -----------------------------------------------------------------------------
# Estado atual: a venda é feita por telefone e o checkout online está desligado
# na interface. O código continua funcional; preencher estas chaves e religar os
# botões em templates/dashboard/upgrade.html reativa a cobrança automática.
#
# Comportamento sem chave real:
#   - fora de produção  -> modo simulado (checkout "aprova" sem cobrar)
#   - em produção       -> falha alto e avisa o usuário. Nunca libera plano de graça.

# [OBRIGATÓRIA se for cobrar] Chave secreta (sk_live_... ou sk_test_...).
STRIPE_SECRET_KEY=

# [OBRIGATÓRIA se for cobrar] Um price por plano, criados no painel do Stripe.
# Sem o price de um plano, o botão daquele plano avisa que ainda não há
# assinatura online — em vez de abrir um checkout quebrado.
STRIPE_PRICE_ID_SITE=
STRIPE_PRICE_ID_PRO=

# [OBRIGATÓRIA se for cobrar] Segredo do webhook (whsec_...).
# Sem ele o endpoint /billing/webhook responde 503 e recusa qualquer POST:
# sem assinatura verificada não há como distinguir o Stripe de um impostor.
# É o webhook que rebaixa quem cancela ou fura o pagamento.
STRIPE_WEBHOOK_SECRET=


# -----------------------------------------------------------------------------
# Alerta de reserva no WhatsApp (CallMeBot, gratuito)
# -----------------------------------------------------------------------------
# [OPCIONAL] Sem a chave, nenhum alerta é disparado e o cliente do bar continua
# com o botão "avisar no WhatsApp" — a reserva nunca se perde.
# A chave é amarrada ao número que fez o opt-in; o destino é o WhatsApp
# cadastrado no painel do próprio bar, não uma variável global.
CALLMEBOT_APIKEY=


# -----------------------------------------------------------------------------
# Taxa de instalação (proposta de venda)
# -----------------------------------------------------------------------------
# [OPCIONAL] Cobrança única de registrar o domínio e publicar o site, exibida na
# proposta do Modo Campo. Sem esta variável a linha simplesmente não aparece —
# dá pra testar o discurso com alguns bares antes de fixar o preço.
#
# Referência de custo: .com.br no registro.br custa ~R$40/ano.
# Exemplo: FEIRA_TAXA_SETUP="R$ 97"
FEIRA_TAXA_SETUP=


# -----------------------------------------------------------------------------
# Upload de foto (Modo Campo)
# -----------------------------------------------------------------------------
# [OBRIGATÓRIA em produção] Sem ela, subir foto pelo celular é impossível: o
# filesystem da Vercel é read-only, então o upload tenta gravar em disco, falha
# e responde 503 com a mensagem explicando o que falta.
#
# Onde pegar: painel da Vercel -> Storage -> criar um Blob store -> a variável
# BLOB_READ_WRITE_TOKEN é injetada no projeto automaticamente ao conectar.
#
# Em desenvolvimento, deixe vazia: o upload grava em app/static/img/demo/<slug>/,
# a mesma pasta que o aplicador de leads lê.
BLOB_READ_WRITE_TOKEN=


# -----------------------------------------------------------------------------
# Manutenção em produção
# -----------------------------------------------------------------------------
# [OPCIONAL, temporária] O Alembic não roda no boot (em serverless, cold starts
# concorrentes disputariam a mesma migration). Estas ações fazem a manutenção
# sob demanda, protegidas por token comparado em tempo constante.
#
#   /bootstrap-demo?token=$SEED_TOKEN&action=status        diagnóstico e planos
#   ...&action=constraints                                 uniques/índices reais
#   ...&action=schema                                      ADD COLUMN faltantes
#   ...&action=migrate&stamp=<revisao>                     alembic com advisory lock
#   ...&action=demos[&slug=X]                              publica prévias de leads
#   ...&action=seed&parte=site                             reaplica conteúdo do site
#
# Fluxo: definir a variável -> deploy -> chamar a ação -> REMOVER a variável e
# fazer deploy de novo. Sem ela o endpoint responde 404.
SEED_TOKEN=


# -----------------------------------------------------------------------------
# Ferramentas destrutivas (somente desenvolvimento)
# -----------------------------------------------------------------------------
# [OPCIONAL] Registra /admin-dev/db, /admin-dev/seed-vegan e /admin-dev/reset-db.
#
# AVISO: /admin-dev/reset-db executa db.drop_all() — apaga todas as tabelas.
#
# Proteções: exige ADMIN_DEV_TOKEN, e habilitar junto com APP_ENV=production
# levanta erro no boot (a configuração errada aparece no deploy, não meses
# depois). Ver app/routes/admin_dev/.
ENABLE_ADMIN_ENDPOINTS=
ADMIN_DEV_TOKEN=


# -----------------------------------------------------------------------------
# Observabilidade
# -----------------------------------------------------------------------------
# [OPCIONAL] Sentry. Ausente = nenhum monitoramento, sem erro no boot.
SENTRY_DSN=
# Amostragem de performance (0.0 a 1.0). Padrão 0.0 = só erros.
SENTRY_TRACES_SAMPLE_RATE=0.0


# -----------------------------------------------------------------------------
# Definidas pela plataforma — não preencha
# -----------------------------------------------------------------------------
# VERCEL              injetada pela Vercel; ativa instance_path=/tmp (FS read-only)
#                     e faz run.py assumir produção quando APP_ENV não está definida.
# RAILWAY_ENVIRONMENT idem, para deploys na Railway.
