# AleroPrice SaaS — exemplo de variáveis de ambiente.
# Copie para .env e preencha. NUNCA commite o .env real (já está no .gitignore).

# ---------------------------------------------------------------------------
# Core Flask
# ---------------------------------------------------------------------------
# Chave usada para assinar sessões/cookies. Gere uma aleatória e longa em prod.
# Ex.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-aleatoria-longa

# Chave para tokens JWT (se/quando expor API). Se vazio, cai no SECRET_KEY.
JWT_SECRET_KEY=

# ---------------------------------------------------------------------------
# Banco de dados
# ---------------------------------------------------------------------------
# Em dev, se vazio, usa SQLite local (instance/alerodb.sqlite).
# Em produção use Postgres. Aceita postgres:// (convertido para postgresql://).
# Ex.: postgresql://usuario:senha@host:5432/nome_db
DATABASE_URL=

# ---------------------------------------------------------------------------
# Stripe (billing / assinaturas)
# ---------------------------------------------------------------------------
# Chaves do dashboard Stripe. Sem elas o checkout/webhook não funciona.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Segredo do endpoint de webhook (whsec_...), usado para validar eventos Stripe.
STRIPE_WEBHOOK_SECRET=whsec_xxx
# IDs de preço (Price) dos planos. VOLUME é usado no A/B de estratégia de preço.
STRIPE_PRICE_ID_PRO=price_xxx
STRIPE_PRICE_ID_VOLUME=price_xxx

# ---------------------------------------------------------------------------
# Monitoramento de erros (Sentry) — opcional
# ---------------------------------------------------------------------------
# Se definido, ativa captura de erros no boot. Vazio = desligado (no-op).
SENTRY_DSN=
# Amostragem de tracing de performance (0.0 a 1.0). Padrão 0.0 (só erros).
SENTRY_TRACES_SAMPLE_RATE=

# ---------------------------------------------------------------------------
# Endpoints administrativos/perigosos (DEV APENAS)
# ---------------------------------------------------------------------------
# /debug-db, /seed-vegan e /reset-db (este faz db.drop_all()) só são
# registrados quando ENABLE_ADMIN_ENDPOINTS=1 E o ambiente NÃO é produção.
# Deixe vazio/ausente em qualquer ambiente compartilhado ou de produção.
ENABLE_ADMIN_ENDPOINTS=

# ---------------------------------------------------------------------------
# Plataforma (injetadas automaticamente pela hospedagem — NÃO setar à mão)
# ---------------------------------------------------------------------------
# VERCEL=1               # definida pela Vercel; ativa config 'production' + /tmp
# RAILWAY_ENVIRONMENT=   # definida pela Railway; também ativa config 'production'
