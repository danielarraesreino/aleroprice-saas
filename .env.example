# ============================================================
# AleroPriceSaaS (01_alero_saas) — .env.example
# Copie para .env e preencha. NUNCA commitar o .env real.
# ============================================================

# ---- Core ----
SECRET_KEY=                                  # OBRIGATÓRIO em produção (sessão/CSRF)
DATABASE_URL=postgresql://user:senha@host:5432/alero   # OBRIGATÓRIO em produção
APP_ENV=production                           # production | development | testing
# VERCEL=1                                   # auto (deploy Vercel)

# ---- Stripe (billing) ----
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_PRICE_ID_SITE=price_...
STRIPE_PRICE_ID_PRO=price_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ---- IA (agentes X-Men + OCR) ----
# Fonte única recomendada: o gateway local OpenAI-compatible (freellmapi via
# localhost:3001). Com OPENAI_BASE_URL + OPENAI_API_KEY, OCR e agentes usam o
# gateway — sem depender de chaves soltas (~/.nvidia_key, ~/.deepseek_key).
OPENAI_BASE_URL=http://localhost:3001/v1
OPENAI_API_KEY=

# Overrides de modelo no gateway (opcionais):
# AI_VISION_MODEL=llama-3.2-11b-vision
# AI_TEXT_MODEL=llama-3.3-70b-instruct
# AI_DEEPSEEK_MODEL=deepseek-chat

# Fallback (quando o gateway local está fora do ar):
DEEPSEEK_API_KEY=
NVIDIA_API_KEY=

# ---- WhatsApp (CallMeBot) ----
CALLMEBOT_APIKEY=
CALLMEBOT_PHONE=

# ---- Admin / segurança ----
# ENABLE_ADMIN_ENDPOINTS=1                   # NUNCA em produção (/reset-db, /seed-vegan)
SEED_TOKEN=
ADMIN_DEV_TOKEN=

# ---- Sentry (opcional) ----
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# ---- Blob (uploads) ----
BLOB_READ_WRITE_TOKEN=

# ---- Domínio do produto ----
DOMINIO_PRODUTO=https://feiradebarao.com.br
# SEPARAR_DOMINIOS=1

# ---- Campanha Feira de Barão (preços/convite) ----
FEIRA_MARCA=Feira de Barão
FEIRA_PRECO=
FEIRA_PRECO_SITE=
FEIRA_PRECO_PRO=
FEIRA_PRECO_PERIODO=mensal
FEIRA_TAXA_SETUP=
FEIRA_WHATSAPP=
FEIRA_EMAIL=
FEIRA_DIAS_TRIAL=
FEIRA_CONVITE=
FEIRA_CONVITE_PRECO_SITE=
FEIRA_CONVITE_PRECO_PRO=
FEIRA_CONVITE_ROTULO=
FEIRA_CONVITE_VAGAS=
FEIRA_COMPRA_SITE=
FEIRA_COMPRA_RENOVACAO=

# Brevo (e-mail transacional + leads). Sem chave, nada é enviado nem salvo.
BREVO_API_KEY=
BREVO_REMETENTE=contato@feiradebarao.com.br
BREVO_REMETENTE_NOME=Feira de Barão
BREVO_LISTA_COMUNIDADE=   # id da lista "Comunidade Barão" (formulário /novidades)
BREVO_LISTA_DONOS=        # id da lista "Donos de bar" (/cadastro)
BREVO_TEMPLATE_DOI=       # id do template de dupla confirmação; vazio = cadastro direto
